# Public Supabase values returned by the project's Connect dialog.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Server-only. Never expose this value in browser code.
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY
# Legacy projects may instead set SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY.

# Optional approval-notification email delivery.
RESEND_API_KEY=re_YOUR_KEY
EMAIL_FROM=Fire and Rescue Academy <accounts@example.com>

# Public production URL used in invitation redirects.
SITE_URL=https://fireandrescueacademy.vercel.app
